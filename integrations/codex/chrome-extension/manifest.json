{
  "manifest_version": 3,
  "name": "Rock Browser Control",
  "version": "0.2.0",
  "description": "Let Rock work in background Chrome tabs and tabs you explicitly share, using your existing website sessions.",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rock Browser Control"
  },
  "key": ""
}
